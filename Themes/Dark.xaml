<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores próprias do Anotado no tema escuro (os controles usam o tema Fluent) -->
    <SolidColorBrush x:Key="PageAreaBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="PageBorderBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="StatusAccentBrush" Color="#E8A86E" />
</ResourceDictionary>
