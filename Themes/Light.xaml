<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Interface -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#FAFAF8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F4F4F1" />
    <SolidColorBrush x:Key="PageAreaBrush" Color="#E6E6E1" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E2DC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D8D8D1" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EBEBE6" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E0E0DA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1F1C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6C706A" />

    <!-- Destaque (verde) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A7613" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#C8F27E" />
    <SolidColorBrush x:Key="AccentFillTextBrush" Color="#1D1F1C" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E6F1D4" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#E1EECB" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A8641E" />

    <!-- Página (papel) -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FBFAF6" />
    <SolidColorBrush x:Key="PaperLineBrush" Color="#E2E0D8" />
    <SolidColorBrush x:Key="PaperMutedBrush" Color="#8A8A83" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="#262626" />
    <SolidColorBrush x:Key="PaperLinkBrush" Color="#1A5FB4" />
</ResourceDictionary>
