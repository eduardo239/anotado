<Window x:Class="Anotado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotado" Height="780" Width="1100" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TextGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed" />
        <CommandBinding Command="Open" Executed="Open_Executed" />
        <CommandBinding Command="Save" Executed="Save_Executed" />
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="Print" Executed="Print_Executed" />
        <CommandBinding Command="Find" Executed="Find_Executed" />
        <CommandBinding Command="Replace" Executed="Find_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="SaveAs" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu principal -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo" Command="New" />
                <MenuItem Header="_Abrir..." Command="Open" />
                <MenuItem Header="_Salvar" Command="Save" />
                <MenuItem Header="Salvar _como..." Command="SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Imprimir..." Command="Print" />
                <Separator />
                <MenuItem Header="Sai_r" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="_Desfazer" Command="Undo" />
                <MenuItem Header="_Refazer" Command="Redo" />
                <Separator />
                <MenuItem Header="Recor_tar" Command="Cut" />
                <MenuItem Header="_Copiar" Command="Copy" />
                <MenuItem Header="C_olar" Command="Paste" />
                <Separator />
                <MenuItem Header="Selecionar _tudo" Command="SelectAll" />
                <MenuItem Header="_Localizar e substituir..." Command="Find" />
            </MenuItem>
            <MenuItem Header="_Formatar">
                <MenuItem Header="_Negrito" Command="EditingCommands.ToggleBold" />
                <MenuItem Header="_Itálico" Command="EditingCommands.ToggleItalic" />
                <MenuItem Header="_Sublinhado" Command="EditingCommands.ToggleUnderline" />
                <Separator />
                <MenuItem Header="Alinhar à _esquerda" Command="EditingCommands.AlignLeft" />
                <MenuItem Header="_Centralizar" Command="EditingCommands.AlignCenter" />
                <MenuItem Header="Alinhar à _direita" Command="EditingCommands.AlignRight" />
                <MenuItem Header="_Justificar" Command="EditingCommands.AlignJustify" />
                <Separator />
                <MenuItem Header="_Marcadores" Command="EditingCommands.ToggleBullets" />
                <MenuItem Header="N_umeração" Command="EditingCommands.ToggleNumbering" />
                <MenuItem Header="_Aumentar recuo" Command="EditingCommands.IncreaseIndentation" />
                <MenuItem Header="_Diminuir recuo" Command="EditingCommands.DecreaseIndentation" />
            </MenuItem>
            <MenuItem Header="_Inserir">
                <MenuItem Header="_Imagem..." Click="InsertImage_Click" />
                <MenuItem Header="_Data e hora" Click="InsertDate_Click" />
            </MenuItem>
            <MenuItem Header="E_xibir">
                <MenuItem Header="_Ampliar" Click="ZoomIn_Click" InputGestureText="Ctrl+Roda" />
                <MenuItem Header="_Reduzir" Click="ZoomOut_Click" />
                <MenuItem Header="_100%" Click="ZoomReset_Click" />
                <Separator />
                <MenuItem Header="_Tema">
                    <MenuItem x:Name="ThemeLightItem" Header="_Claro" IsCheckable="True" Click="ThemeLight_Click" />
                    <MenuItem x:Name="ThemeDarkItem" Header="_Escuro" IsCheckable="True" Click="ThemeDark_Click" />
                    <MenuItem x:Name="ThemeSystemItem" Header="_Seguir o Windows" IsCheckable="True" Click="ThemeSystem_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Aj_uda">
                <MenuItem Header="_Sobre o Anotado" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Barra de ferramentas -->
        <ToolBarTray x:Name="ToolBars" DockPanel.Dock="Top">
            <ToolBar Band="0">
                <Button Command="New" ToolTip="Novo (Ctrl+N)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" /></Button>
                <Button Command="Open" ToolTip="Abrir (Ctrl+O)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" /></Button>
                <Button Command="Save" ToolTip="Salvar (Ctrl+S)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" /></Button>
                <Button Command="Print" ToolTip="Imprimir (Ctrl+P)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE749;" /></Button>
                <Separator />
                <Button Command="Undo" ToolTip="Desfazer (Ctrl+Z)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;" /></Button>
                <Button Command="Redo" ToolTip="Refazer (Ctrl+Y)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button Command="Cut" ToolTip="Recortar (Ctrl+X)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" /></Button>
                <Button Command="Copy" ToolTip="Copiar (Ctrl+C)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" /></Button>
                <Button Command="Paste" ToolTip="Colar (Ctrl+V)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" /></Button>
            </ToolBar>

            <ToolBar Band="0">
                <ComboBox x:Name="FontFamilyBox" Width="170" IsEditable="True" ToolTip="Fonte"
                          TextSearch.TextPath="Source"
                          DropDownClosed="FontFamilyBox_DropDownClosed" KeyDown="FontFamilyBox_KeyDown">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="14" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="FontSizeBox" Width="76" IsEditable="True" ToolTip="Tamanho da fonte"
                          DropDownClosed="FontSizeBox_DropDownClosed" KeyDown="FontSizeBox_KeyDown" />
                <Button Command="EditingCommands.IncreaseFontSize" ToolTip="Aumentar fonte (Ctrl+])"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E8;" /></Button>
                <Button Command="EditingCommands.DecreaseFontSize" ToolTip="Diminuir fonte (Ctrl+[)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E7;" /></Button>
                <Separator />
                <ToggleButton x:Name="BoldButton" Command="EditingCommands.ToggleBold" ToolTip="Negrito (Ctrl+B)">
                    <TextBlock Style="{StaticResource TextGlyph}" Text="N" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Command="EditingCommands.ToggleItalic" ToolTip="Itálico (Ctrl+I)">
                    <TextBlock Style="{StaticResource TextGlyph}" Text="I" FontStyle="Italic" FontFamily="Georgia" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton" Command="EditingCommands.ToggleUnderline" ToolTip="Sublinhado (Ctrl+U)">
                    <TextBlock Style="{StaticResource TextGlyph}" Text="S" TextDecorations="Underline" />
                </ToggleButton>
                <Button x:Name="FontColorButton" Click="FontColor_Click" ToolTip="Cor da fonte">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D3;" />
                </Button>
                <Button x:Name="HighlightButton" Click="Highlight_Click" ToolTip="Cor de realce">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E6;" />
                </Button>
            </ToolBar>

            <ToolBar Band="1">
                <ToggleButton x:Name="AlignLeftButton" Command="EditingCommands.AlignLeft" ToolTip="Alinhar à esquerda (Ctrl+L)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E4;" /></ToggleButton>
                <ToggleButton x:Name="AlignCenterButton" Command="EditingCommands.AlignCenter" ToolTip="Centralizar (Ctrl+E)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E3;" /></ToggleButton>
                <ToggleButton x:Name="AlignRightButton" Command="EditingCommands.AlignRight" ToolTip="Alinhar à direita (Ctrl+R)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E2;" /></ToggleButton>
                <ToggleButton x:Name="AlignJustifyButton" Command="EditingCommands.AlignJustify" ToolTip="Justificar (Ctrl+J)"><TextBlock Style="{StaticResource TextGlyph}" Text="☰" /></ToggleButton>
                <Separator />
                <Button Command="EditingCommands.ToggleBullets" ToolTip="Marcadores"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" /></Button>
                <Button Command="EditingCommands.ToggleNumbering" ToolTip="Numeração"><TextBlock Style="{StaticResource TextGlyph}" Text="1." FontWeight="SemiBold" FontSize="13" /></Button>
                <Button Command="EditingCommands.DecreaseIndentation" ToolTip="Diminuir recuo"><TextBlock Style="{StaticResource TextGlyph}" Text="⇤" FontFamily="Segoe UI Symbol" /></Button>
                <Button Command="EditingCommands.IncreaseIndentation" ToolTip="Aumentar recuo"><TextBlock Style="{StaticResource TextGlyph}" Text="⇥" FontFamily="Segoe UI Symbol" /></Button>
                <Separator />
                <Button Click="InsertImage_Click" ToolTip="Inserir imagem"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B9;" /></Button>
                <Button Command="Find" ToolTip="Localizar e substituir (Ctrl+F)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" /></Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Barra de localizar/substituir -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Localizar:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FindBox" Width="180" VerticalContentAlignment="Center" KeyDown="FindBox_KeyDown" />
                <TextBlock Text="Substituir por:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="ReplaceBox" Width="180" VerticalContentAlignment="Center" KeyDown="FindBox_KeyDown" />
                <CheckBox x:Name="MatchCaseBox" Content="Diferenciar maiúsculas" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button Content="Próximo" Margin="12,0,0,0" Padding="10,2" Click="FindNext_Click" />
                <Button Content="Substituir" Margin="6,0,0,0" Padding="10,2" Click="Replace_Click" />
                <Button Content="Substituir tudo" Margin="6,0,0,0" Padding="10,2" Click="ReplaceAll_Click" />
                <Button Content="✕" Margin="12,0,0,0" Padding="8,2" ToolTip="Fechar (Esc)" Click="CloseFind_Click" />
            </WrapPanel>
        </Border>

        <!-- Barra de status -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="CountText" Text="0 palavras" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource StatusAccentBrush}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="ZoomSlider" Width="130" Minimum="50" Maximum="300" Value="100"
                            TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged"
                            VerticalAlignment="Center" ToolTip="Zoom" />
                    <TextBlock x:Name="ZoomText" Text="100%" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Área da página -->
        <Border Background="{DynamicResource PageAreaBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="PageArea_PreviewMouseWheel">
            <!-- A página fica sempre branca com texto preto, nos dois temas (como no Word),
                 para que o documento salvo/impresso não herde cores do tema escuro. -->
            <Border HorizontalAlignment="Center" Margin="0,16,0,0" Background="White"
                    BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1,1,1,0">
                <RichTextBox x:Name="Editor" Width="816"
                             Background="White" Foreground="Black" CaretBrush="Black"
                             AcceptsTab="True" BorderThickness="0" Padding="0"
                             SpellCheck.IsEnabled="True" Language="pt-BR"
                             IsInactiveSelectionHighlightEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="Editor_TextChanged"
                             SelectionChanged="Editor_SelectionChanged"
                             ContextMenuOpening="Editor_ContextMenuOpening">
                    <!-- Modelo simples: sem a borda/linha de foco do estilo Fluent, para parecer uma folha. -->
                    <RichTextBox.Template>
                        <ControlTemplate TargetType="RichTextBox">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </RichTextBox.Template>
                    <RichTextBox.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                    </RichTextBox.LayoutTransform>
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </RichTextBox.Resources>
                    <RichTextBox.ContextMenu>
                        <ContextMenu />
                    </RichTextBox.ContextMenu>
                </RichTextBox>
            </Border>
        </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
