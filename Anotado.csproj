<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Anotado.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Anotado.ico" />
    <!-- Fontes dos conjuntos (Inter, Merriweather, JetBrains Mono), embutidas no app -->
    <Resource Include="Assets\fonts\*.ttf" />
    <!-- Palavras mais usadas do português, em ordem de frequência: reserva do autocompletar -->
    <EmbeddedResource Include="Dict\palavras_mais_comuns_do_portugu_s.txt" LogicalName="Anotado.Dict.PalavrasComuns.txt" />
  </ItemGroup>

</Project>
