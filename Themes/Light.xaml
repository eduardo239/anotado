<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores próprias do Anotado no tema claro (os controles usam o tema Fluent) -->
    <SolidColorBrush x:Key="PageAreaBrush" Color="#E6E6E8" />
    <SolidColorBrush x:Key="PageBorderBrush" Color="#CFCFD3" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="StatusAccentBrush" Color="#A0522D" />
</ResourceDictionary>
