<Window x:Class="Anotado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotado" Icon="/Anotado;component/Assets/Anotado.ico" Height="900" Width="1440" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed" />
        <CommandBinding Command="Open" Executed="Open_Executed" />
        <CommandBinding Command="Save" Executed="Save_Executed" />
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="Print" Executed="Print_Executed" />
        <CommandBinding Command="Find" Executed="Find_Executed" />
        <CommandBinding Command="Replace" Executed="Find_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="SaveAs" Gesture="Ctrl+Shift+S" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{DynamicResource ChromeBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- barra superior -->
            <RowDefinition Height="Auto" />   <!-- abas -->
            <RowDefinition Height="Auto" />   <!-- barra de formatação -->
            <RowDefinition Height="*" />      <!-- conteúdo -->
            <RowDefinition Height="Auto" />   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ============================================================ Barra superior -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,0,24,0" Height="74">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="anotado" FontSize="26" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
                <Border DockPanel.Dock="Left" Width="1" Height="30" Margin="28,0,26,0" Background="{DynamicResource LineBrush}" />
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock x:Name="DocTitleText" Text="Documento sem título" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DocPathText" Text="Ainda não salvo" Style="{StaticResource Muted}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="56,22,0,0">
                    <Ellipse x:Name="SavedDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SavedText" Text="Salvo" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="Save" ToolTip="Salvar (Ctrl+S)" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,10,0" />
                        <TextBlock Text="Salvar" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="Print" ToolTip="Imprimir ou gerar PDF (Ctrl+P)" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,10,0" />
                        <TextBlock Text="Imprimir" />
                    </StackPanel>
                </Button>
                <Button x:Name="FocusButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="FocusMode_Click" ToolTip="Modo foco (F11)" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FocusIcon" Style="{StaticResource Icon}" Text="&#xE740;" Margin="0,0,10,0" />
                        <TextBlock x:Name="FocusLabel" Text="Modo foco" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============================================================ Abas -->
        <Border x:Name="TabsBar" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,0,24,0" Height="40">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Shortcuts_Click" ToolTip="Atalhos de teclado (F1)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Atalhos" Style="{StaticResource Muted}" />
                        <TextBlock Text="F1" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" Margin="22,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="FileTab" Style="{StaticResource TabButton}" Content="Arquivo" Click="FileTab_Click" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="Início" Tag="HomePanel" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="Inserir" Tag="InsertPanel" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="Layout" Tag="LayoutPanel" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="Revisão" Tag="ReviewPanel" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="Exibir" Tag="ViewPanel" Checked="Tab_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ Barra de formatação (muda com a aba) -->
        <Border x:Name="RibbonBar" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,0,24,0" Height="58">
            <DockPanel>
                <ComboBox x:Name="ModeBox" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" SelectedIndex="0"
                          SelectionChanged="ModeBox_SelectionChanged" ToolTip="Modo de edição">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE70F;" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Editando" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE736;" Margin="0,0,10,0" />
                            <TextBlock Text="Leitura" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Grid x:Name="RibbonPanels" VerticalAlignment="Center">
                    <!-- Início -->
                    <StackPanel x:Name="HomePanel" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="Undo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Desfazer (Ctrl+Z)"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                        <Button Style="{StaticResource IconButton}" Command="Redo" CommandTarget="{Binding ElementName=Editor}" ToolTip="Refazer (Ctrl+Y)"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                        <Border Style="{StaticResource VDivider}" />
                        <ComboBox x:Name="StyleBox" Width="140" ToolTip="Estilo do parágrafo" SelectionChanged="StyleBox_SelectionChanged">
                            <ComboBoxItem Content="Texto normal" Tag="Normal" />
                            <ComboBoxItem Content="Título" Tag="Title" FontSize="16" FontWeight="Bold" />
                            <ComboBoxItem Content="Título 1" Tag="Heading1" FontSize="15" FontWeight="SemiBold" />
                            <ComboBoxItem Content="Título 2" Tag="Heading2" FontWeight="SemiBold" />
                            <ComboBoxItem Content="Citação" Tag="Quote" FontStyle="Italic" />
                        </ComboBox>
                        <Border Style="{StaticResource VDivider}" />
                        <ComboBox x:Name="FontFamilyBox" Width="150" IsEditable="True" ToolTip="Fonte"
                                  TextSearch.TextPath="Source"
                                  DropDownClosed="FontFamilyBox_DropDownClosed" KeyDown="FontFamilyBox_KeyDown">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="FontSizeBox" Width="76" IsEditable="True" Margin="6,0,0,0" ToolTip="Tamanho da fonte"
                                  DropDownClosed="FontSizeBox_DropDownClosed" KeyDown="FontSizeBox_KeyDown" />
                        <Border Style="{StaticResource VDivider}" />
                        <ToggleButton x:Name="BoldButton" Style="{StaticResource IconToggle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="Negrito (Ctrl+B)">
                            <TextBlock Text="N" FontWeight="Bold" FontSize="15" Width="16" TextAlignment="Center" />
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicButton" Style="{StaticResource IconToggle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="Itálico (Ctrl+I)">
                            <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="15" Width="16" TextAlignment="Center" />
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineButton" Style="{StaticResource IconToggle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="Sublinhado (Ctrl+U)">
                            <TextBlock Text="S" TextDecorations="Underline" FontSize="15" Width="16" TextAlignment="Center" />
                        </ToggleButton>
                        <Button x:Name="FontColorButton" Style="{StaticResource IconButton}" Click="FontColor_Click" ToolTip="Cor da fonte">
                            <Grid>
                                <TextBlock Text="A" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <Border Height="2" Width="14" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Button>
                        <Button x:Name="HighlightButton" Style="{StaticResource IconButton}" Click="Highlight_Click" ToolTip="Cor de realce"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E6;" /></Button>
                        <Border Style="{StaticResource VDivider}" />
                        <ToggleButton x:Name="AlignLeftButton" Style="{StaticResource IconToggle}" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="Alinhar à esquerda (Ctrl+L)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E4;" /></ToggleButton>
                        <ToggleButton x:Name="AlignCenterButton" Style="{StaticResource IconToggle}" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="Centralizar (Ctrl+E)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E3;" /></ToggleButton>
                        <ToggleButton x:Name="AlignRightButton" Style="{StaticResource IconToggle}" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="Alinhar à direita (Ctrl+R)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E2;" /></ToggleButton>
                        <ToggleButton x:Name="AlignJustifyButton" Style="{StaticResource IconToggle}" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}" ToolTip="Justificar (Ctrl+J)"><TextBlock Text="☰" FontSize="14" Width="16" TextAlignment="Center" /></ToggleButton>
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="Marcadores"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" /></Button>
                        <Button Style="{StaticResource IconButton}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="Numeração"><TextBlock Text="1." FontWeight="SemiBold" Width="16" TextAlignment="Center" /></Button>
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Click="InsertLink_Click" ToolTip="Inserir link (Ctrl+K)"><TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" /></Button>
                    </StackPanel>

                    <!-- Inserir -->
                    <StackPanel x:Name="InsertPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" Click="InsertImage_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" Margin="0,0,8,0" /><TextBlock Text="Imagem" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="InsertTable_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" Margin="0,0,8,0" /><TextBlock Text="Tabela" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="InsertLink_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,8,0" /><TextBlock Text="Link" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="InsertDate_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE787;" Margin="0,0,8,0" /><TextBlock Text="Data e hora" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Layout -->
                    <StackPanel x:Name="LayoutPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Espaçamento entre linhas" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,10,0" />
                        <ComboBox x:Name="LineSpacingBox" Width="90" DropDownClosed="LineSpacingBox_DropDownClosed">
                            <ComboBoxItem Content="1,0" Tag="1.0" />
                            <ComboBoxItem Content="1,15" Tag="1.15" />
                            <ComboBoxItem Content="1,5" Tag="1.5" />
                            <ComboBoxItem Content="2,0" Tag="2.0" />
                        </ComboBox>
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Command="EditingCommands.DecreaseIndentation" CommandTarget="{Binding ElementName=Editor}" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇤" FontFamily="Segoe UI Symbol" Margin="0,0,8,0" /><TextBlock Text="Diminuir recuo" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="EditingCommands.IncreaseIndentation" CommandTarget="{Binding ElementName=Editor}" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇥" FontFamily="Segoe UI Symbol" Margin="0,0,8,0" /><TextBlock Text="Aumentar recuo" /></StackPanel>
                        </Button>
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Click="ShowPageSetup_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" Margin="0,0,8,0" /><TextBlock Text="Configurar página" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Revisão -->
                    <StackPanel x:Name="ReviewPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <ToggleButton x:Name="SpellToggle" Style="{StaticResource IconToggle}" IsChecked="True" Click="SpellToggle_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="abc" FontWeight="SemiBold" TextDecorations="Underline" Margin="0,0,8,0" /><TextBlock Text="Verificar ortografia" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="AutoCompleteToggle" Style="{StaticResource IconToggle}" Click="AutoCompleteToggle_Click" Padding="10,6"
                                      ToolTip="Sugere o fim da palavra enquanto você digita. Tab aceita, Esc dispensa.">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ab|" FontWeight="SemiBold" Margin="0,0,8,0" /><TextBlock Text="Autocompletar" /></StackPanel>
                        </ToggleButton>
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Command="Find" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" /><TextBlock Text="Localizar e substituir" /></StackPanel>
                        </Button>
                        <Border Style="{StaticResource VDivider}" />
                        <TextBlock Text="Idioma da revisão: Português (Brasil)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>

                    <!-- Exibir -->
                    <StackPanel x:Name="ViewPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <ToggleButton x:Name="NavToggle" Style="{StaticResource IconToggle}" Click="NavToggle_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A0;" Margin="0,0,8,0" /><TextBlock Text="Navegação" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="DocPanelToggle" Style="{StaticResource IconToggle}" Click="DocPanelToggle_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE89F;" Margin="0,0,8,0" /><TextBlock Text="Painel do documento" /></StackPanel>
                        </ToggleButton>
                        <Button Style="{StaticResource IconButton}" Click="FocusMode_Click" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE740;" Margin="0,0,8,0" /><TextBlock Text="Modo foco" /></StackPanel>
                        </Button>
                        <Border Style="{StaticResource VDivider}" />
                        <TextBlock Text="Tema" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <ToggleButton x:Name="ThemeLightButton" Style="{StaticResource IconToggle}" Click="ThemeLight_Click" Padding="10,6" Content="Claro" />
                        <ToggleButton x:Name="ThemeDarkButton" Style="{StaticResource IconToggle}" Click="ThemeDark_Click" Padding="10,6" Content="Escuro" />
                        <ToggleButton x:Name="ThemeSystemButton" Style="{StaticResource IconToggle}" Click="ThemeSystem_Click" Padding="10,6" Content="Seguir o Windows" />
                        <Border Style="{StaticResource VDivider}" />
                        <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Reduzir"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                        <Button Style="{StaticResource IconButton}" Click="ZoomReset_Click" Content="100%" Padding="10,6" />
                        <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Ampliar"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================================================ Conteúdo -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Painel de navegação -->
            <Border x:Name="NavPanel" Grid.Column="0" Width="230" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,0">
                    <DockPanel DockPanel.Dock="Top" Margin="12,24,4,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="NavToggle_Click" ToolTip="Ocultar navegação" MinWidth="26" MinHeight="26" Padding="4">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE76B;" />
                        </Button>
                        <TextBlock Text="Navegação" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" CornerRadius="6" Padding="12,0" Height="36" Margin="4,0,4,24">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE721;" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Buscar no texto" Style="{StaticResource Muted}" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="NavSearchBox" Style="{StaticResource BareTextBox}" Margin="24,0,0,0" FontSize="12"
                                     TextChanged="NavSearchBox_TextChanged" KeyDown="NavSearchBox_KeyDown" />
                        </Grid>
                    </Border>

                    <!-- Rodapé do painel -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="4,12,4,14" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="18" VerticalAlignment="Top" Foreground="{DynamicResource MutedBrush}" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Seu espaço, seu ritmo." FontSize="12" />
                                <TextBlock Text="F1 para ver os atalhos" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="12,0,12,10">
                        <TextBlock x:Name="SectionCountText" DockPanel.Dock="Right" Text="0 seções" Style="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Text="ESTRUTURA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <TextBlock x:Name="OutlineEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="12,4,12,0" FontSize="12"
                                   Text="Use os estilos Título, Título 1 e Título 2 (aba Início) para montar a estrutura do documento." />
                        <ListBox x:Name="OutlineList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource OutlineItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="OutlineList_PreviewMouseLeftButtonUp">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Área central -->
            <DockPanel Grid.Column="1">
                <!-- Localizar e substituir -->
                <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="16,10"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Localizar" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="FindBox" Width="180" VerticalContentAlignment="Center" KeyDown="FindBox_KeyDown" />
                        <TextBlock Text="Substituir por" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,8,0" />
                        <TextBox x:Name="ReplaceBox" Width="180" VerticalContentAlignment="Center" KeyDown="FindBox_KeyDown" />
                        <CheckBox x:Name="MatchCaseBox" Content="Diferenciar maiúsculas" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Próximo" Margin="14,0,0,0" Padding="12,5" Click="FindNext_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Substituir" Margin="6,0,0,0" Padding="12,5" Click="Replace_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="Substituir tudo" Margin="6,0,0,0" Padding="12,5" Click="ReplaceAll_Click" />
                        <Button Style="{StaticResource IconButton}" Margin="10,0,0,0" ToolTip="Fechar (Esc)" Click="CloseFind_Click">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;" />
                        </Button>
                    </WrapPanel>
                </Border>

                <Border Background="{DynamicResource PageAreaBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="PageArea_PreviewMouseWheel">
                        <!-- A folha: cabeçalho, texto e rodapé -->
                        <Grid x:Name="Page" HorizontalAlignment="Center" Margin="0,32,0,32">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <!-- Sombra numa camada separada: efeito aplicado no texto o deixaria borrado -->
                            <Border Background="{DynamicResource PaperBrush}" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="Black" />
                                </Border.Effect>
                            </Border>
                            <Border Background="{DynamicResource PaperBrush}" CornerRadius="2">
                            <DockPanel>
                                <Border x:Name="PageHeader" DockPanel.Dock="Top" Margin="66,40,66,0" Padding="0,0,0,12"
                                        BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock x:Name="HeaderDateText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource PaperMutedBrush}" />
                                        <TextBlock x:Name="HeaderPathText" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource PaperMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                                <Border x:Name="PageFooter" DockPanel.Dock="Bottom" Margin="66,0,66,14" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource PaperLineBrush}" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="FooterWordsText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource PaperMutedBrush}" />
                                        <TextBlock x:Name="FooterNameText" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource PaperMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>

                                <Grid>
                                <RichTextBox x:Name="Editor" Background="Transparent" Foreground="#262626" CaretBrush="#262626"
                                             AcceptsTab="True" BorderThickness="0" Padding="0"
                                             SpellCheck.IsEnabled="True" Language="pt-BR"
                                             IsInactiveSelectionHighlightEnabled="True" IsDocumentEnabled="True"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="Editor_TextChanged"
                                             SelectionChanged="Editor_SelectionChanged"
                                             ContextMenuOpening="Editor_ContextMenuOpening">
                                    <RichTextBox.Template>
                                        <ControlTemplate TargetType="RichTextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </RichTextBox.Template>
                                    <RichTextBox.Resources>
                                        <Style TargetType="Paragraph">
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                        </Style>
                                    </RichTextBox.Resources>
                                    <RichTextBox.ContextMenu>
                                        <ContextMenu />
                                    </RichTextBox.ContextMenu>
                                </RichTextBox>
                                <!-- Autocompletar: restante sugerido da palavra, desenhado sobre o editor -->
                                <Canvas x:Name="SuggestionLayer" IsHitTestVisible="False" ClipToBounds="True">
                                    <TextBlock x:Name="SuggestionText" Foreground="{DynamicResource PaperMutedBrush}" Visibility="Collapsed" />
                                </Canvas>
                                </Grid>
                            </DockPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- Painel do documento -->
            <Border x:Name="DocPanel" Grid.Column="2" Width="266" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,22,20">
                        <DockPanel Margin="0,20,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="DocPanelToggle_Click" ToolTip="Ocultar painel" MinWidth="26" MinHeight="26" Padding="4">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE76C;" />
                            </Button>
                            <TextBlock Text="Documento" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource LineBrush}" />

                        <TextBlock Text="CONFIGURAÇÃO DA PÁGINA" Style="{StaticResource SectionLabel}" Margin="0,20,0,14" />
                        <TextBlock Text="Formato" FontSize="12" Margin="0,0,0,8" />
                        <ComboBox x:Name="PageFormatBox" SelectionChanged="PageSetup_Changed" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="A4 · 210 × 297 mm" Tag="A4" />
                            <ComboBoxItem Content="Carta · 216 × 279 mm" Tag="Carta" />
                            <ComboBoxItem Content="Ofício · 216 × 356 mm" Tag="Oficio" />
                        </ComboBox>
                        <TextBlock Text="Orientação" FontSize="12" Margin="0,14,0,8" />
                        <ComboBox x:Name="OrientationBox" SelectionChanged="PageSetup_Changed" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Retrato" />
                            <ComboBoxItem Content="Paisagem" />
                        </ComboBox>
                        <TextBlock Text="Margens" FontSize="12" Margin="0,14,0,8" />
                        <ComboBox x:Name="MarginsBox" SelectionChanged="PageSetup_Changed" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Estreita · 1,27 cm" Tag="Estreita" />
                            <ComboBoxItem Content="Normal · 2,5 cm" Tag="Normal" />
                            <ComboBoxItem Content="Larga · 3,18 cm" Tag="Larga" />
                        </ComboBox>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,22,0,0" />
                        <TextBlock Text="ESTATÍSTICAS" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Palavras" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatWords" Grid.Column="1" Text="0" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Caracteres" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatChars" Grid.Row="1" Grid.Column="1" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="Tempo de leitura" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatReading" Grid.Row="2" Grid.Column="1" Text="0 min" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="Idioma" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Português (BR)" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="META DE ESCRITA" Style="{StaticResource SectionLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock x:Name="GoalCurrentText" Text="0" FontSize="22" />
                                    <TextBlock Text=" / " FontSize="22" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBox x:Name="GoalBox" Style="{StaticResource BareTextBox}" FontSize="22" MinWidth="30"
                                             ToolTip="Clique para alterar a meta" LostFocus="GoalBox_Commit" KeyDown="GoalBox_KeyDown" />
                                    <TextBlock Text="palavras" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,4,0,0" />
                                </StackPanel>
                                <Grid x:Name="GoalTrack" Height="3" Margin="0,14,0,0" SizeChanged="GoalTrack_SizeChanged">
                                    <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="1.5" />
                                    <Border x:Name="GoalFill" Background="{DynamicResource AccentBrush}" CornerRadius="1.5"
                                            HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="GoalCaption" Text="Uma ideia de cada vez." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Backup automático -->
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,22,0,0" />
                        <DockPanel Margin="0,20,0,12">
                            <ToggleButton x:Name="BackupToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                          Click="BackupToggle_Click" ToolTip="Ligar ou desligar o backup automático" />
                            <TextBlock Text="BACKUP AUTOMÁTICO" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="A cada salvamento, uma cópia com data e hora vai para a pasta abaixo."
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Card}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock x:Name="BackupFolderIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE8B7;"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="BackupFolderText" Text="Nenhuma pasta escolhida" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Content="Escolher pasta…" Click="ChooseBackupFolder_Click" />
                            <Button x:Name="OpenBackupButton" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Content="Abrir" Margin="6,0,0,0"
                                    Click="OpenBackupFolder_Click" ToolTip="Abrir a pasta de backup no Explorador de Arquivos" />
                        </StackPanel>
                        <DockPanel Margin="0,12,0,0">
                            <ComboBox x:Name="BackupKeepBox" DockPanel.Dock="Right" Width="120" SelectionChanged="BackupKeepBox_SelectionChanged">
                                <ComboBoxItem Content="10 cópias" />
                                <ComboBoxItem Content="30 cópias" />
                                <ComboBoxItem Content="100 cópias" />
                                <ComboBoxItem Content="Todas" />
                            </ComboBox>
                            <TextBlock Text="Manter" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       ToolTip="Quantas cópias de cada documento guardar. As mais antigas são apagadas." />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse x:Name="BackupDot" Width="6" Height="6" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="BackupStatusText" Text="Desativado" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="200" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="4,22,0,0">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xEA18;" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="PrivacyNoteText" Text="Salvo só no seu computador." Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================ Barra de status -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0" Height="36">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" MinWidth="22" MinHeight="22" Padding="4" ToolTip="Reduzir">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE738;" />
                    </Button>
                    <Slider x:Name="ZoomSlider" Width="110" Minimum="50" Maximum="300" Value="100" Margin="6,0"
                            TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged"
                            VerticalAlignment="Center" ToolTip="Zoom (Ctrl + roda do mouse)" />
                    <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" MinWidth="22" MinHeight="22" Padding="4" ToolTip="Ampliar">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE710;" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusWordsText" Text="0 palavras" Style="{StaticResource Muted}" />
                    <Border Width="1" Height="14" Margin="16,0" Background="{DynamicResource LineBrush}" />
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusSavedText" Text="Salvo" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                    <Border Width="1" Height="14" Margin="16,0" Background="{DynamicResource LineBrush}" />
                    <TextBlock Text="Português (Brasil)" Style="{StaticResource Muted}" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
