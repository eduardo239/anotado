<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Interface -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#121416" />
    <SolidColorBrush x:Key="PanelBrush" Color="#15181B" />
    <SolidColorBrush x:Key="PageAreaBrush" Color="#202328" />
    <SolidColorBrush x:Key="LineBrush" Color="#262A2F" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1D21" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E3338" />
    <SolidColorBrush x:Key="HoverBrush" Color="#23272C" />
    <SolidColorBrush x:Key="PressedBrush" Color="#2C3137" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8E9E6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C9196" />

    <!-- Destaque (verde-limão) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#BFE878" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#C8F27E" />
    <SolidColorBrush x:Key="AccentFillTextBrush" Color="#121416" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1F2A19" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#2A3620" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8B86E" />

    <!-- Página (papel) -->
    <SolidColorBrush x:Key="PaperBrush" Color="#F3F2ED" />
    <SolidColorBrush x:Key="PaperLineBrush" Color="#DAD8D0" />
    <SolidColorBrush x:Key="PaperMutedBrush" Color="#85857E" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="#262626" />
</ResourceDictionary>
